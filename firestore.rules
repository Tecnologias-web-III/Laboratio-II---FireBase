rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read, write: if request.auth != null;
    }
    match /incidencias/{incidenciaId} {
      allow read, write: if request.auth != null;
    }
    match /bitacora_incidencias/{docId} {
      allow read, write: if request.auth != null;
    }
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }
  }
}